# Shipyard environment variables.
#
# In the current per-target architecture, shipyard/.env is REGENERATED every
# run by scripts/preflight.sh, which concatenates two sources:
#
#   - shipyard/.env.shared       (operator-level secrets — see .env.shared.example)
#   - <target>/.env              (target-level overrides — see .env.target.example)
#
# Don't edit shipyard/.env directly — your changes will be lost at the next run.
# Edit one of the two source files instead.
#
# This file remains in the repo as a quick reference for the union of both
# sources — the variables your final .env will contain after preflight stages it.

# ----- Operator-level (lives in .env.shared) -----
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-key-here
SHIPYARD_RELAY_URL=https://shipyard-production-29ae.up.railway.app
SHIPYARD_RELAY_KEY=your-relay-key-here
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=your@email.com

# ----- Target-level (lives in <target>/.env) -----
LANGCHAIN_PROJECT=YourTargetName
GIT_REMOTE_ORIGIN=https://<github-pat>@github.com/<user>/<repo>.git
GIT_REMOTE_MIRROR=

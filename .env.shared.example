# Shipyard operator-level secrets — shared across all targets.
# Copy this file to .env.shared and fill in your real values.
# Per-target values (LANGCHAIN_PROJECT, GIT_REMOTE_ORIGIN, etc.) live in <target>/.env.

# LangSmith tracing (operator-level — API key is global, project varies per target)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-key-here

# Shipyard relay (shared infrastructure — points at the dashboard's Railway service)
SHIPYARD_RELAY_URL=https://shipyard-production-29ae.up.railway.app
SHIPYARD_RELAY_KEY=your-relay-key-here

# Git commit identity (operator-level for solo operators; override per target if needed)
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=your@email.com

.cursor/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
*.egg

# Environment — both the staged shipyard/.env (regenerated by scripts/preflight.sh
# per run) and shipyard/.env.shared (operator secrets) are gitignored. The
# *.example template files stay tracked.
.env*
!.env*.example

# Factory config — staged shipyard/factory.yaml (rewritten by scripts/preflight.sh
# per run) and rotated factory.yaml.old breadcrumbs are gitignored. The
# factory.yaml.example template stays tracked.
factory.yaml*
!factory.yaml.example

# Runtime artifacts (agent-generated)
logs/
reviews/
checkpoints/
fix-plan.md
target/

# Node modules & package files (gauntlet_docs PDF tooling)
gauntlet_docs/node_modules/
gauntlet_docs/package.json
gauntlet_docs/package-lock.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# SQLite checkpoints
*.db
*.sqlite

# Shipyard factory configuration — per-target.
# Lives at <target>/factory.yaml (committed to the target's repo).
# Pre-flight script copies this into shipyard/factory.yaml at build time
# and (if mutated by save_ci_fix_pre_existing) copies it back at run end.
# Secrets stay in .env — never put API keys here.

operator:
  first_name: "Your"
  last_name: "Name"
  email: "your@email.com"

github:
  username: "your-gh-handle"
  target_repo: "TargetName"
  target_remote_url: "https://github.com/your-gh-handle/TargetName.git"

git:
  author_name: "Your Name"
  author_email: "your@email.com"

langsmith:
  project: "TargetName"

target:
  dir: "C:\\absolute\\path\\to\\TargetName"   # Windows: double-backslashes

# Review configuration.
# Set story_level to false to skip the mid-epic batch code-review
# pipeline (epic-end review still runs after all stories complete).
# The CLI flag --no-story-reviews and the interactive [Y/n] startup
# prompt feed the same toggle — any of the three opt-out paths
# disables batch reviews for the run.
reviews:
  story_level: true

# Batch-review pipeline. Fires every N successfully-completed stories
# within an epic, interrupting story cascades before they snowball into
# epic-end. Default 4: review fires after stories 4, 8, 12, ... ;
# leftover stories (e.g. 9-11 in an 11-story epic) fold into the
# regular epic-end review, no redundant final batch.
#   0 disables the trigger (epic-end review only — equivalent to the
#     pre-2026-05-09 behavior).
#   N >= 1 fires the batch pipeline every N completed stories.
review:
  story_batch_size: 4

# CI configuration.
# Set story_level to false to skip per-story CI runs
# (fix_ci retry loop is also skipped; commits still happen).
# fix_pre_existing_errors: true = greenfield (fix every CI error),
#   false = brownfield-rebuild (scope-constrain fixes to current story/epic).
# Operator is prompted at startup; this value is the default shown.
ci:
  story_level: true
  fix_pre_existing_errors: false

# Per-node model overrides.
# Valid values: null (use CLI default), or Anthropic API model aliases:
#   "claude-haiku-4-5", "claude-sonnet-4-6", "claude-opus-4-6".
models:
  # Story-level nodes (orchestrator.py)
  dev_story: claude-sonnet-4-6
  fix_ci: claude-sonnet-4-6

  # Epic-end nodes (epic_graph.py)
  epic_review: claude-sonnet-4-6
  epic_analysis: claude-sonnet-4-6
  epic_fix_cat_a: claude-sonnet-4-6
  epic_architect: claude-opus-4-6
  epic_fix_dev: claude-sonnet-4-6

  # Mid-epic batch nodes (epic_graph.py). Mirror epic-end defaults out
  # of the box; tune separately to (e.g.) drop batch review to haiku
  # while keeping epic-end review on sonnet.
  epic_batch_review: claude-sonnet-4-6
  epic_batch_analysis: claude-sonnet-4-6
  epic_batch_fix_cat_a: claude-sonnet-4-6
  epic_batch_architect: claude-opus-4-6
  epic_batch_fix_dev: claude-sonnet-4-6

# Shipyard factory configuration — per-target.
# Lives at <target>/factory.yaml (committed to the target's repo).
# Pre-flight script copies this into shipyard/factory.yaml at build time
# and (if mutated by save_ci_fix_pre_existing) copies it back at run end.
# Secrets stay in .env — never put API keys here.

operator:
  first_name: "Your"
  last_name: "Name"
  email: "your@email.com"

github:
  username: "your-gh-handle"
  target_repo: "TargetName"
  target_remote_url: "https://github.com/your-gh-handle/TargetName.git"

git:
  author_name: "Your Name"
  author_email: "your@email.com"

langsmith:
  project: "TargetName"

target:
  dir: "C:\\absolute\\path\\to\\TargetName"   # Windows: double-backslashes

# Review configuration.
# Set story_level to false to skip per-story code reviews
# (epic-level reviews still run after all stories complete).
reviews:
  story_level: true

# CI configuration.
# Set story_level to false to skip per-story CI runs
# (fix_ci retry loop is also skipped; commits still happen).
# fix_pre_existing_errors: true = greenfield (fix every CI error),
#   false = brownfield-rebuild (scope-constrain fixes to current story/epic).
# Operator is prompted at startup; this value is the default shown.
ci:
  story_level: true
  fix_pre_existing_errors: false

# Per-node model overrides.
# Valid values: null (use CLI default), or Anthropic API model aliases:
#   "claude-haiku-4-5", "claude-sonnet-4-6", "claude-opus-4-6".
models:
  # Story-level nodes (orchestrator.py)
  dev_story: claude-sonnet-4-6
  code_review: claude-sonnet-4-6
  fix_ci: claude-sonnet-4-6

  # Epic-level nodes (epic_graph.py)
  epic_review: claude-sonnet-4-6
  epic_analysis: claude-sonnet-4-6
  epic_fix_cat_a: claude-sonnet-4-6
  epic_architect: claude-opus-4-6
  epic_fix_dev: claude-sonnet-4-6

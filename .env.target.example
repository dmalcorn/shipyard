# Per-target environment variables. Lives at <target>/.env (gitignored in target repo).
# Pre-flight script concatenates this with shipyard/.env.shared to produce
# shipyard/.env at build time.

# LangSmith trace bucket — use the target's exact name (e.g., PawprintRecipes)
LANGCHAIN_PROJECT=YourTargetName

# Target's GitHub remote — embed a fine-grained PAT for non-interactive pushes.
# See gauntlet_docs/git-remote-setup-guide.md for PAT scopes and creation.
GIT_REMOTE_ORIGIN=https://<github-pat>@github.com/<user>/<repo>.git

# Optional secondary mirror (e.g., GitLab). Leave blank to disable.
GIT_REMOTE_MIRROR=
